# ---- Google (Google Cloud Console OAuth client) ----
# From Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Email delivery (Resend) ----
RESEND_API_KEY=
# Address the finished playbook gets emailed to
REPORT_TO_EMAIL=5townstoivel@gmail.com
# "From" address must be on a domain you've verified in Resend
REPORT_FROM_EMAIL=agent@yourdomain.com

# ---- Behavior ----
# How many months back to scan
SCAN_MONTHS=12
# Hard cap on number of emails scanned per run (cost/time control)
MAX_MESSAGES=400
# How many emails per extraction batch sent to Claude
BATCH_SIZE=20

# ---- App ----
PORT=3000
# Random long string used to sign the session cookie
SESSION_SECRET=change-me-to-a-random-string
